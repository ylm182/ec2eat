# Local emulator configuration only; demo values are not live credentials.
APP_MODE=emulator
APP_ORIGIN=http://localhost:3000
GOOGLE_CLOUD_PROJECT=demo-ec2eat
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ec2eat
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
GEMINI_MODEL=gemini-3.5-flash-lite
VERTEX_LOCATION=global
# LAYA_BASE_URL and LAYA_MODEL_REVISION intentionally unset until M5 smoke test.

# Optional synthetic M4 fixtures (emulator only): rain-busy | all-day | failures.
# CONTEXT_FIXTURE=rain-busy
# Live integrations intentionally unset. Never populate these with invented values:
# OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET, CALENDAR_KMS_KEY
# GOOGLE_WEATHER_API_KEY; GOOGLE_WEATHER_PERSIST_APPROVED=true only after policy/retention review.
# GEMINI_CONTEXT_ENABLED=true only after real Vertex model/location smoke testing.

# LAYA_RUNTIME_VERSION and HF_TOKEN also remain unset; a verified installed recipe is mandatory.

# Optional M6 synthetic restaurants (emulator only). Unset means unavailable.
# PLACES_FIXTURE=results
# Choices: results | empty | failure | closed | details-failure
# Live: GOOGLE_PLACES_API_KEY (server secret) and PLACES_CONTENT_USE_APPROVED=true.
# PLACES_MODEL_INPUT_APPROVED=true is a SEPARATE terms/permission gate; default false.
# No persistent Google restaurant fields or generated enrichment is enabled.
